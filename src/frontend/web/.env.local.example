# Copier en .env.local pour du développement local (dotnet run sur chaque service,
# ports fixés par Properties/launchSettings.json). En dev/uat/prod K8s, ces valeurs sont
# figées au build de l'image (Dockerfile : chemins relatifs /api/*, routage Traefik), pas par ce fichier.
NEXT_PUBLIC_IDENTITY_API_URL=http://localhost:5101
NEXT_PUBLIC_CATALOG_API_URL=http://localhost:5102
NEXT_PUBLIC_NOTIFICATION_API_URL=http://localhost:5104
