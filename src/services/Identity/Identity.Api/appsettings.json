{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },
  "Jwt": {
    "Issuer": "collector-identity",
    "Audience": "collector-api",
    "ExpiryMinutes": 15,
    "RefreshExpiryDays": 7
  },
  "Omnia": {
    "BaseUrl": "https://omnia-monitoring.com"
  }
}
