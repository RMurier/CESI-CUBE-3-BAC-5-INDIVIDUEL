<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Librairie de fixtures/aides partagées (consommée via ProjectReference par les *.Api.Tests),
         pas un projet de tests lui-même — sans ce flag, "dotnet test" sur toute la solution le
         détecte comme candidat (il référence xunit) et tente de lancer un test-host pour son .dll,
         qui échoue à la résolution d'assembly car il lui manque Microsoft.NET.Test.Sdk. -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Collector.Messaging\Collector.Messaging.csproj" />
  </ItemGroup>

</Project>
