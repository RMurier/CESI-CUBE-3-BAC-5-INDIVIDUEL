<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Pas Sdk.Web : juste besoin des types HttpContext/IExceptionHandlerFeature/ProblemDetails pour
       OmniaExceptionLogging (et IHttpClientFactory/IConfiguration pour OmniaClient), sans faire de
       cette librairie partagée une appli web elle-même. Microsoft.Extensions.Http et
       Microsoft.Extensions.Configuration.Abstractions sont déjà fournis par ce FrameworkReference
       (pas de PackageReference explicite dessus : NU1510, "already available"). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Collector.Observability.Tests" />
  </ItemGroup>

</Project>
